# Copy to .env and replace placeholders locally. Never commit .env.
# The default sender uses Together; the small example uses an OpenRouter monitor/receiver.
TOGETHER_API_KEY="REPLACE_WITH_YOUR_TOGETHER_KEY"
OPENROUTER_API_KEY="REPLACE_WITH_YOUR_OPENROUTER_KEY"
# Required for the gpt5mini monitor and OpenAI judging/paraphrasing scripts.
OPENAI_API_KEY="REPLACE_WITH_YOUR_OPENAI_KEY"
# Optional alternate senders/annotators.
ANTHROPIC_API_KEY="REPLACE_WITH_YOUR_ANTHROPIC_KEY"
BASETEN_API_KEY="REPLACE_WITH_YOUR_BASETEN_KEY"
